{
  "ReverseProxy": {
    "Routes": {
      "productsRoute": {
        "ClusterId": "productsCluster",
        "Match": {
          "Path": "/products/{**catch-all}"
        }
      },
      "customersRoute": {
        "ClusterId": "customersCluster",
        "Match": {
          "Path": "/customers/{**catch-all}"
        }
      },
      "ordersRoute": {
        "ClusterId": "ordersCluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "productsCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5040/"
          }
        }
      },
      "customersCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5024/"
          }
        }
      },
      "ordersCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5051/"
          }
        }
      }
    }
  }
}
